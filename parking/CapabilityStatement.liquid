<div xmlns="http://www.w3.org/1999/xhtml">
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(to bottom,#f2f6fa,#e8eef5);color:#1d1d1f;padding:28px 18px;line-height:1.5;">
<div style="max-width:1000px;margin:0 auto;">
<div style="background:linear-gradient(135deg,#007aff,#5ac8fa);color:#ffffff;padding:28px 24px;border-radius:16px;text-align:center;box-shadow:0 8px 24px rgba(0,122,255,0.25);margin-bottom:24px;">
<div style="font-size:26px;font-weight:600;margin-bottom:6px;">{{ iif(title.exists(), title, name) }}</div>
<div style="font-size:14px;opacity:0.95;">{% if kind.exists() %}Kind: {{ kind }}{% endif %}{% if fhirVersion.exists() %} · FHIR {{ fhirVersion }}{% endif %}{% if format.exists() %} · Formats: {{ format.join(', ') }}{% endif %}</div>
</div>
{% if description.exists() %}<div style="background:#ffffff;border-radius:14px;padding:22px 24px;margin-bottom:22px;box-shadow:0 4px 16px rgba(0,0,0,0.07);"><div style="font-size:15px;color:#333333;">{{ description }}</div></div>{% endif %}
{% for r in rest %}
<div style="background:#ffffff;border-radius:14px;padding:22px 24px;margin-bottom:22px;box-shadow:0 4px 16px rgba(0,0,0,0.07);">
<div style="font-size:20px;font-weight:600;color:#007aff;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e5e5ea;">{{ iif(r.mode = 'server', 'Server', 'Client') }} capabilities</div>
{% if r.documentation.exists() %}<p style="margin:0 0 12px 0;font-size:14px;color:#333333;">{{ r.documentation }}</p>{% endif %}
{% if r.security.exists() %}<p style="margin:0 0 12px 0;font-size:14px;color:#333333;"><strong>Security:</strong> {% if r.security.service.exists() %}{{ r.security.service.coding.code.first() }}. {% endif %}{{ r.security.description }}</p>{% endif %}
{% if r.interaction.exists() %}<p style="margin:0 0 12px 0;font-size:14px;"><strong>System interactions:</strong> {% for si in r.interaction %}<code>{{ si.code }}</code> <span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(si.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(si.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(si.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(si.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), si.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span> {% endfor %}</p>{% endif %}
<div style="font-weight:600;margin:16px 0 8px 0;color:#1d1d1f;">Resource summary</div>
<table style="border-collapse:collapse;width:100%;"><tr><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Resource</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Expectation</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">read</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">vread</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">create</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">update</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">delete</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">history-instance</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">search-type</th></tr>
{% for res in r.resource %}<tr><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;"><a href="#{{ r.mode }}-{{ res.type }}">{{ res.type }}</a></td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;"><span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span></td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'read').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'read').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'read').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'read').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'read').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'read').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'vread').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'vread').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'vread').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'vread').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'vread').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'vread').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'create').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'create').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'create').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'create').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'create').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'create').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'update').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'update').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'update').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'update').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'update').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'update').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'delete').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'delete').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'delete').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'delete').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'delete').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'delete').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'history-instance').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'history-instance').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'history-instance').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'history-instance').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'history-instance').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'history-instance').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if res.interaction.where(code = 'search-type').exists() %}<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.interaction.where(code = 'search-type').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.interaction.where(code = 'search-type').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.interaction.where(code = 'search-type').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.interaction.where(code = 'search-type').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.interaction.where(code = 'search-type').extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span>{% endif %}</td>
</tr>{% endfor %}</table>
</div>
{% for res in r.resource %}
<div style="background:#ffffff;border-radius:14px;padding:22px 24px;margin-bottom:22px;box-shadow:0 4px 16px rgba(0,0,0,0.07);">
<div style="font-size:20px;font-weight:600;color:#007aff;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e5e5ea;"><a name="{{ r.mode }}-{{ res.type }}"> </a>{{ res.type }} <span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), res.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span></div>
{% if res.supportedProfile.exists() %}<p style="margin:0 0 8px 0;font-size:14px;"><strong>Profiles:</strong> {% for p in res.supportedProfile %}{% if p.startsWith('http://hl7.org/fhir/uv/rwi-pharma/StructureDefinition/') %}<a href="{{ p.replace('http://hl7.org/fhir/uv/rwi-pharma/StructureDefinition/', 'StructureDefinition-') + '.html' }}">{{ p.replace('http://hl7.org/fhir/uv/rwi-pharma/StructureDefinition/', '') }}</a>{% else %}{{ p }}{% endif %} {% endfor %}</p>{% endif %}
{% if res.documentation.exists() %}<p style="margin:0 0 8px 0;font-size:14px;color:#333333;">{{ res.documentation }}</p>{% endif %}
{% if res.interaction.exists() %}<p style="margin:0 0 8px 0;font-size:14px;"><strong>Interactions:</strong> {% for i in res.interaction %}<code>{{ i.code }}</code> <span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(i.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(i.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(i.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(i.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), i.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span> {% endfor %}</p>{% endif %}
{% if res.versioning.exists() or res.readHistory.exists() or res.conditionalCreate.exists() or res.conditionalUpdate.exists() or res.updateCreate.exists() or res.conditionalDelete.exists() %}<p style="margin:0 0 8px 0;font-size:13px;color:#555555;">{% if res.versioning.exists() %}Versioning: <code>{{ res.versioning }}</code>. {% endif %}{% if res.readHistory.exists() %}Read history: {{ res.readHistory }}. {% endif %}{% if res.updateCreate.exists() %}Update creates: {{ res.updateCreate }}. {% endif %}{% if res.conditionalCreate.exists() %}Conditional create: {{ res.conditionalCreate }}. {% endif %}{% if res.conditionalUpdate.exists() %}Conditional update: {{ res.conditionalUpdate }}. {% endif %}{% if res.conditionalDelete.exists() %}Conditional delete: <code>{{ res.conditionalDelete }}</code>.{% endif %}</p>{% endif %}
{% if res.searchInclude.exists() %}<p style="margin:0 0 8px 0;font-size:13px;"><strong>_include:</strong> {% for x in res.searchInclude %}<code>{{ x }}</code> {% endfor %}</p>{% endif %}
{% if res.searchRevInclude.exists() %}<p style="margin:0 0 8px 0;font-size:13px;"><strong>_revinclude:</strong> {% for x in res.searchRevInclude %}<code>{{ x }}</code> {% endfor %}</p>{% endif %}
{% if res.searchParam.exists() %}<table style="border-collapse:collapse;width:100%;margin-top:8px;"><tr><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Search parameter</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Type</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Expectation</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Notes</th></tr>{% for sp in res.searchParam %}<tr><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{% if sp.definition.startsWith('http://hl7.org/fhir/uv/rwi-pharma/SearchParameter/') %}<a href="{{ sp.definition.replace('http://hl7.org/fhir/uv/rwi-pharma/SearchParameter/', 'SearchParameter-') + '.html' }}"><code>{{ sp.name }}</code></a>{% else %}<code>{{ sp.name }}</code>{% endif %}</td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{{ sp.type }}</td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;"><span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(sp.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(sp.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(sp.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(sp.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), sp.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span></td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{{ iif(sp.documentation.exists(), sp.documentation, '') }}</td></tr>{% endfor %}</table>{% endif %}
{% if res.operation.exists() %}<table style="border-collapse:collapse;width:100%;margin-top:8px;"><tr><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Operation</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Expectation</th><th style="text-align:left;padding:6px 8px;border-bottom:2px solid #d1d5db;font-size:13px;color:#374151;">Definition</th></tr>{% for op in res.operation %}<tr><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;"><code>${{ op.name }}</code></td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;"><span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:700;color:#ffffff;background:{{ iif(op.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHALL', '#1d4ed8', iif(op.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'SHOULD', '#0891b2', iif(op.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first() = 'MAY', '#6b7280', '#9ca3af'))) }};">{{ iif(op.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first().exists(), op.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation').value.first(), 'yes') }}</span></td><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;font-size:13px;vertical-align:top;">{{ op.definition }}</td></tr>{% endfor %}</table>{% endif %}
</div>
{% endfor %}
{% endfor %}
</div>
