Instance: RWIpharmaRegulatorClientActor
InstanceOf: ActorDefinition
Usage: #definition
Title: "RWI-pharma Regulator Client"
Description: "The regulator's internal system that progresses Tasks on the RWI-pharma Server, adds outputs such as acknowledgments, validation reports and decisions, and creates child Tasks such as questions and invoices."
* id = "rwipharma-regulator-client"
* url = "http://hl7.org/fhir/uv/rwi-pharma/ActorDefinition/rwipharma-regulator-client"
* name = "RWIpharmaRegulatorClient"
* title = "RWI-pharma Regulator Client"
* status = #active
* experimental = false
* date = "2026-10-29"
* type = #system
* description = "The regulator's internal system that progresses Tasks on the RWI-pharma Server, adds outputs such as acknowledgments, validation reports and decisions, and creates child Tasks such as questions and invoices."
* capabilities = "http://hl7.org/fhir/uv/rwi-pharma/CapabilityStatement/rwipharma-regulator-client"

Instance: RWIpharmaNotificationReceiverActor
InstanceOf: ActorDefinition
Usage: #definition
Title: "RWI-pharma Notification Receiver"
Description: "The applicant's notification endpoint (rest-hook) that receives subscription notification Bundles from the RWI-pharma Server. It is not a FHIR server, so it has requirement statements but no CapabilityStatement."
