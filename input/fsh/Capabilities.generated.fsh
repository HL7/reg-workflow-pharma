Instance: TaskInputSearchParameter
InstanceOf: SearchParameter
Usage: #definition
Title: "Task Input Reference"
Description: "Search Tasks by a resource referenced from Task.input, for example a DocumentReference. FHIR R5 defines the equivalent output search parameter (Task-output) but none for inputs, so this guide adds it to allow Task?input=... and _include=Task:input."
* id = "Task-input"
* url = "http://hl7.org/fhir/uv/rwi-pharma/SearchParameter/Task-input"
* name = "TaskInput"
* title = "Task Input Reference"
* status = #active
* experimental = false
* date = "2026-10-29"
* description = "Search Tasks by a resource referenced from Task.input, for example a DocumentReference. FHIR R5 defines the equivalent output search parameter (Task-output) but none for inputs, so this guide adds it to allow Task?input=... and _include=Task:input."
* code = #input
* base = #Task
* type = #reference
* expression = "Task.input.value.ofType(Reference)"
* processingMode = #normal

