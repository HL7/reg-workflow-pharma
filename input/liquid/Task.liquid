{% assign rqAddr = iif(rqRef = 'Organization/org-synthpharma-ag', '123 Synthetic Research Blvd, 4000 Basel, Switzerland', iif(rqRef = 'Organization/org-ema-srm-hmed', 'Regulatory Authority Headquarters, 1083 HS Capital City, Country', '')) %}
{% assign rqContact = iif(rqRef = 'Organization/org-synthpharma-ag', 'Dr. John Doe, Head of Regulatory Affairs', iif(rqRef = 'Organization/org-ema-srm-hmed', 'Scientific and Regulatory Management', '')) %}
{% assign rqEmail = iif(rqRef = 'Organization/org-synthpharma-ag', 'john.doe@synthpharma.example', iif(rqRef = 'Organization/org-ema-srm-hmed', 'regulatory@health-authority.example', '')) %}
<div style="{{ iif(owner.exists(), 'margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #eeeeee;', 'margin-bottom:0;padding-bottom:0;border-bottom:none;') }}">
<span style="font-weight:600;color:#007aff;margin-bottom:4px;display:block;">Requester</span>
{% if rqName != '' %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;">{{ rqName }}</div>
<div style="font-size:14px;color:#555555;line-height:1.5;"><div><strong>Address:</strong> {{ rqAddr }}</div><div><strong>Contact:</strong> {{ rqContact }}</div><div><strong>Email:</strong> {{ rqEmail }}</div></div>
{% elsif requester.reference.exists() and requester.reference.startsWith('http').not() and requester.reference.startsWith('#').not() %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;"><a href="{{ requester.reference.replace('/', '-') + '.html' }}">{{ iif(requester.display.exists(), requester.display, requester.reference) }}</a></div>
{% else %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;">{{ iif(requester.display.exists(), requester.display, requester.reference) }}</div>
{% endif %}
</div>
{% endif %}
{% if owner.exists() %}
{% assign owRef = owner.reference %}
{% assign owName = iif(owRef = 'Organization/org-synthpharma-ag', 'SynthPharma AG', iif(owRef = 'Organization/org-ema-srm-hmed', 'Health Authority – Regulatory Review Division', '')) %}
{% assign owAddr = iif(owRef = 'Organization/org-synthpharma-ag', '123 Synthetic Research Blvd, 4000 Basel, Switzerland', iif(owRef = 'Organization/org-ema-srm-hmed', 'Regulatory Authority Headquarters, 1083 HS Capital City, Country', '')) %}
{% assign owContact = iif(owRef = 'Organization/org-synthpharma-ag', 'Dr. John Doe, Head of Regulatory Affairs', iif(owRef = 'Organization/org-ema-srm-hmed', 'Scientific and Regulatory Management', '')) %}
{% assign owEmail = iif(owRef = 'Organization/org-synthpharma-ag', 'john.doe@synthpharma.example', iif(owRef = 'Organization/org-ema-srm-hmed', 'regulatory@health-authority.example', '')) %}
<div style="margin-bottom:0;padding-bottom:0;border-bottom:none;">
<span style="font-weight:600;color:#007aff;margin-bottom:4px;display:block;">Owner</span>
{% if owName != '' %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;">{{ owName }}</div>
<div style="font-size:14px;color:#555555;line-height:1.5;"><div><strong>Address:</strong> {{ owAddr }}</div><div><strong>Contact:</strong> {{ owContact }}</div><div><strong>Email:</strong> {{ owEmail }}</div></div>
{% elsif owner.reference.exists() and owner.reference.startsWith('http').not() and owner.reference.startsWith('#').not() %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;"><a href="{{ owner.reference.replace('/', '-') + '.html' }}">{{ iif(owner.display.exists(), owner.display, owner.reference) }}</a></div>
{% else %}<div style="font-size:16px;font-weight:500;margin-bottom:8px;color:#1d1d1f;">{{ iif(owner.display.exists(), owner.display, owner.reference) }}</div>
{% endif %}
</div>
{% endif %}
</div>
{% endif %}

<div style="background:#ffffff;border-radius:18px;padding:32px;margin-bottom:32px;box-shadow:0 8px 28px rgba(0,0,0,0.08),0 2px 10px rgba(0,0,0,0.06);">
<div style="font-size:24px;font-weight:600;color:#007aff;margin:0 0 24px 0;padding-bottom:12px;border-bottom:1px solid #e5e5ea;display:flex;justify-content:space-between;align-items:center;">Input Documents{% if input.exists() %}<span style="background:#007aff;color:#ffffff;font-size:14px;font-weight:600;padding:6px 14px;border-radius:20px;">{{ input.count().toString() + iif(input.count() = 1, ' document', ' documents') }}</span>{% endif %}</div>
{% if input.exists() %}
{% for g in inGroups %}
{% if g != '__all__' %}<div style="margin:24px 0;padding:20px;background:#f8fbff;border-radius:14px;border-left:5px solid #007aff;"><div style="margin:0 0 16px 0;font-size:18px;color:#007aff;font-weight:600;">{{ iif(g = '__other__', 'Other documents', g) }}</div>{% endif %}
{% for x in input %}
{% if g = '__all__' or (g = '__other__' and x.value.ofType(Reference).resolve().category.empty()) or (x.value.ofType(Reference).resolve().category.coding.display contains g) %}
<div style="background:#ffffff;border:1px solid #d1e4ff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
<div style="font-weight:600;color:#007aff;font-size:15px;">{{ iif(x.type.coding.display.exists(), x.type.coding.display.first(), iif(x.type.text.exists(), x.type.text, x.type.coding.code.first())) }}</div>
{% if x.type.coding.code.exists() %}<span style="font-family:Menlo,Monaco,Consolas,monospace;background:#e5f2ff;padding:2px 8px;border-radius:6px;font-size:13px;">{{ x.type.coding.code.first() }}</span><br />{% endif %}
{% if x.value.ofType(Reference).exists() %}
{% if x.value.ofType(Reference).reference.exists() and x.value.ofType(Reference).reference.startsWith('http').not() and x.value.ofType(Reference).reference.startsWith('#').not() %}<a href="{{ x.value.ofType(Reference).reference.replace('/', '-') + '.html' }}">{{ iif(x.value.ofType(Reference).resolve().content.attachment.title.exists(), x.value.ofType(Reference).resolve().content.attachment.title.first(), iif(x.value.ofType(Reference).display.exists(), x.value.ofType(Reference).display, x.value.ofType(Reference).reference)) }}</a>{% else %}{{ iif(x.value.ofType(Reference).display.exists(), x.value.ofType(Reference).display, x.value.ofType(Reference).reference) }}{% endif %}
{% if x.value.ofType(Reference).resolve().type.coding.display.exists() %}<div style="font-size:13px;color:#555555;margin-top:4px;">{{ x.value.ofType(Reference).resolve().type.coding.display.first() }}</div>{% elsif x.value.ofType(Reference).resolve().type.text.exists() %}<div style="font-size:13px;color:#555555;margin-top:4px;">{{ x.value.ofType(Reference).resolve().type.text }}</div>{% endif %}
{% endif %}
</div>
{% endif %}
{% endfor %}
{% if g != '__all__' %}</div>{% endif %}
{% endfor %}
{% else %}
<div style="text-align:center;padding:40px 20px;color:#888888;background:#f9f9f9;border-radius:14px;">No input content</div>
{% endif %}
</div>

<div style="background:#ffffff;border-radius:18px;padding:32px;margin-bottom:32px;box-shadow:0 8px 28px rgba(0,0,0,0.08),0 2px 10px rgba(0,0,0,0.06);">
<div style="font-size:24px;font-weight:600;color:#007aff;margin:0 0 24px 0;padding-bottom:12px;border-bottom:1px solid #e5e5ea;display:flex;justify-content:space-between;align-items:center;">Output Documents{% if output.exists() %}<span style="background:#34c759;color:#ffffff;font-size:14px;font-weight:600;padding:6px 14px;border-radius:20px;">{{ output.count().toString() + iif(output.count() = 1, ' document', ' documents') }}</span>{% endif %}</div>
{% if output.exists() %}
{% for g in outGroups %}
{% if g != '__all__' %}<div style="margin:24px 0;padding:20px;background:#f4fbf6;border-radius:14px;border-left:5px solid #34c759;"><div style="margin:0 0 16px 0;font-size:18px;color:#34c759;font-weight:600;">{{ iif(g = '__other__', 'Other documents', g) }}</div>{% endif %}
{% for x in output %}
{% if g = '__all__' or (g = '__other__' and x.value.ofType(Reference).resolve().category.empty()) or (x.value.ofType(Reference).resolve().category.coding.display contains g) %}
<div style="background:#ffffff;border:1px solid #ccebd3;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
<div style="font-weight:600;color:#34c759;font-size:15px;">{{ iif(x.type.coding.display.exists(), x.type.coding.display.first(), iif(x.type.text.exists(), x.type.text, x.type.coding.code.first())) }}</div>
{% if x.type.coding.code.exists() %}<span style="font-family:Menlo,Monaco,Consolas,monospace;background:#e6f9eb;padding:2px 8px;border-radius:6px;font-size:13px;">{{ x.type.coding.code.first() }}</span><br />{% endif %}
{% if x.value.ofType(Reference).exists() %}
{% if x.value.ofType(Reference).reference.exists() and x.value.ofType(Reference).reference.startsWith('http').not() and x.value.ofType(Reference).reference.startsWith('#').not() %}<a href="{{ x.value.ofType(Reference).reference.replace('/', '-') + '.html' }}">{{ iif(x.value.ofType(Reference).resolve().content.attachment.title.exists(), x.value.ofType(Reference).resolve().content.attachment.title.first(), iif(x.value.ofType(Reference).display.exists(), x.value.ofType(Reference).display, x.value.ofType(Reference).reference)) }}</a>{% else %}{{ iif(x.value.ofType(Reference).display.exists(), x.value.ofType(Reference).display, x.value.ofType(Reference).reference) }}{% endif %}
{% if x.value.ofType(Reference).resolve().type.coding.display.exists() %}<div style="font-size:13px;color:#555555;margin-top:4px;">{{ x.value.ofType(Reference).resolve().type.coding.display.first() }}</div>{% elsif x.value.ofType(Reference).resolve().type.text.exists() %}<div style="font-size:13px;color:#555555;margin-top:4px;">{{ x.value.ofType(Reference).resolve().type.text }}</div>{% endif %}
{% endif %}
</div>
{% endif %}
{% endfor %}
{% if g != '__all__' %}</div>{% endif %}
{% endfor %}
{% else %}
<div style="text-align:center;padding:40px 20px;color:#888888;background:#f9f9f9;border-radius:14px;">No output content</div>
{% endif %}
</div>

<div style="text-align:center;padding:50px;color:#666666;font-size:14px;">HL7 FHIR R5 – Regulatory Workflows and Interactions - pharma (RWI-Pharma)<br />Generated Render</div>
