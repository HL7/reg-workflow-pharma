{% assign lm = lastModified.toString() %}
{% assign stColor = iif(status = 'completed', '#28a745', iif(status in ('rejected' | 'failed' | 'cancelled' | 'entered-in-error'), '#dc3545', iif(status = 'on-hold', '#ffc107', iif(status in ('accepted' | 'received' | 'ready' | 'in-progress'), '#17a2b8', '#007aff')))) %}
{% assign bsCode = businessStatus.coding.code.first() %}
{% assign bsColor = iif(bsCode in ('approved' | 'validation-successful' | 'payment-received' | 'response-accepted' | 'authorised' | 'authorised-with-conditions' | 'accepted' | 'complete' | 'labelling-agreed' | 'may-proceed' | 'filed-accepted-for-review' | 'notification-accepted' | 'change-implemented' | 'meeting-granted' | 'designation-granted' | 'fee-waiver-granted' | 'extension-granted' | 'clinical-hold-lifted' | 'refund-issued'), '#28a745', iif(bsCode in ('rejected' | 'validation-failed' | 'refused-to-file' | 'not-authorised' | 'meeting-denied' | 'designation-denied' | 'fee-waiver-denied' | 'extension-denied' | 'payment-overdue' | 'complete-response-issued' | 'withdrawn' | 'on-clinical-hold'), '#dc3545', iif(bsCode in ('clock-stop' | 'payment-requested' | 'questions-issued' | 'awaiting-applicant-response' | 'request-for-information-issued' | 'further-information-required' | 'labelling-comments-issued' | 'decision-pending'), '#ffc107', '#8e8e93'))) %}
{% assign inCats = input.value.ofType(Reference).resolve().category.coding.display.distinct() %}
{% assign inGroups = iif(inCats.exists(), inCats.combine(iif(input.where(value.ofType(Reference).resolve().category.empty()).exists(), '__other__', {})), '__all__') %}
{% assign outCats = output.value.ofType(Reference).resolve().category.coding.display.distinct() %}
{% assign outGroups = iif(outCats.exists(), outCats.combine(iif(output.where(value.ofType(Reference).resolve().category.empty()).exists(), '__other__', {})), '__all__') %}
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(to bottom,#f2f6fa,#e8eef5);color:#1d1d1f;margin:0;padding:40px 20px;line-height:1.5;">
<div style="max-width:1000px;margin:0 auto;">

{% if meta.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/instance-description').exists() %}
<div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:0 0 24px 0;font-size:15px;color:#1e3a8a;line-height:1.6;">
<div style="font-weight:600;margin-bottom:4px;">About this example</div>
<div>{{ meta.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/instance-description').value.first() }}</div>
<div style="font-size:13px;font-style:italic;margin-top:8px;">{% if meta.versionId.exists() %}Version {{ meta.versionId }} of the Task{% if identifier.where(type.coding.code = 'rwipharmataskinstance').exists() %} with RWI Pharma Task Instance ID {{ identifier.where(type.coding.code = 'rwipharmataskinstance').value.first() }}{% endif %}. {% endif %}All versions of a Task share one Task.id on a server. <a href="rwipharmatask.html#task-identifiers">Why versions are shown as separate examples</a></div>
</div>
{% endif %}
<div style="background:linear-gradient(135deg,#007aff,#5ac8fa);color:#ffffff;padding:40px 24px;border-radius:18px;text-align:center;box-shadow:0 10px 30px rgba(0,122,255,0.3);margin-bottom:36px;">
<div style="margin:0 0 8px 0;font-size:32px;font-weight:600;">Task{% if codeDisp != '' %}: {{ codeDisp }}{% endif %}</div>
<p style="margin:0;opacity:0.95;font-size:17px;">HL7 FHIR R5 – RWI-Pharma Implementation Guide</p>
</div>

{% if description.exists() or codeDisp != '' %}
<div style="background:#ffffff;border-radius:18px;padding:32px;margin-bottom:32px;box-shadow:0 8px 28px rgba(0,0,0,0.08),0 2px 10px rgba(0,0,0,0.06);">
<div style="font-size:24px;font-weight:600;color:#007aff;margin:0 0 24px 0;padding-bottom:12px;border-bottom:1px solid #e5e5ea;display:flex;justify-content:space-between;align-items:center;">Task Description</div>
<div style="font-size:18px;line-height:1.6;color:#333333;">{{ iif(description.exists(), description, codeDisp) }}</div>
</div>
{% endif %}

<div style="background:#ffffff;border-radius:18px;padding:32px;margin-bottom:32px;box-shadow:0 8px 28px rgba(0,0,0,0.08),0 2px 10px rgba(0,0,0,0.06);">
<div style="font-size:24px;font-weight:600;color:#007aff;margin:0 0 24px 0;padding-bottom:12px;border-bottom:1px solid #e5e5ea;display:flex;justify-content:space-between;align-items:center;">Core Task Information</div>
<div style="display:grid;grid-template-columns:max-content auto;gap:12px 20px;align-items:baseline;">
{% if meta.versionId.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Version ID</span><span style="color:#1d1d1f;">{{ meta.versionId }}</span>{% endif %}
{% if identifier.where(type.coding.code = 'rwipharmataskinstance').exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Instance UUID</span><span style="color:#1d1d1f;">{{ identifier.where(type.coding.code = 'rwipharmataskinstance').value.first() }}</span>{% endif %}
{% if groupIdentifier.value.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Group Identifier</span><span style="color:#1d1d1f;">{{ groupIdentifier.value }}</span>{% endif %}
<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Procedure ID</span><span style="color:#1d1d1f;">{{ iif(identifier.where(type.coding.code = 'rwipharmaregulatorprocedureno').exists(), identifier.where(type.coding.code = 'rwipharmaregulatorprocedureno').value.first(), 'not yet assigned') }}</span>
{% if basedOn.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Based On</span><span style="color:#1d1d1f;">{% for b in basedOn %}{% if b.reference.exists() and b.reference.startsWith('http').not() and b.reference.startsWith('#').not() %}<a href="{{ b.reference.replace('/', '-') + '.html' }}">{{ b.reference }}</a>{% elsif b.reference.exists() %}{{ b.reference }}{% else %}{{ iif(b.display.exists(), b.display, '(no reference)') }}{% endif %}<br />{% endfor %}</span>{% endif %}
<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Task Status</span><span style="color:#1d1d1f;"><span style="padding:2px 8px;border-radius:12px;font-size:0.9em;font-weight:500;color:#ffffff;background:{{ stColor }};">{{ status }}</span></span>
{% if businessStatus.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Business Status</span><span style="color:#1d1d1f;"><span style="padding:2px 8px;border-radius:12px;font-size:0.9em;font-weight:500;color:#ffffff;background:{{ bsColor }};">{{ iif(businessStatus.coding.display.exists(), businessStatus.coding.display.first(), iif(businessStatus.text.exists(), businessStatus.text, bsCode)) }}</span></span>{% endif %}
{% if intent.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Intent</span><span style="color:#1d1d1f;">{{ intent }}</span>{% endif %}
{% if priority.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Priority</span><span style="color:#1d1d1f;">{{ priority }}</span>{% endif %}
</div>
{% if code.coding.exists() or authoredOn.exists() or lastModified.exists() %}
<hr style="border:0;border-top:1px solid #eeeeee;margin:20px 0;" />
<div style="display:grid;grid-template-columns:max-content auto;gap:12px 20px;align-items:baseline;">
{% if code.coding.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Code</span><span style="color:#1d1d1f;">{{ iif(code.coding.first().display.exists(), code.coding.first().display + ' (' + code.coding.first().code + ')', code.coding.first().code) }}</span>{% endif %}
{% if authoredOn.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Authored</span><span style="color:#1d1d1f;">{{ iif(au.length() >= 19, au.substring(0, 10) + ' ' + au.substring(11, 8) + iif(au.length() > 19, ' UTC' + iif(au.substring(19) = 'Z', '', au.substring(19)), ''), au) }}</span>{% endif %}
{% if lastModified.exists() %}<span style="font-weight:600;color:#555555;text-align:right;min-width:150px;">Last Updated</span><span style="color:#1d1d1f;">{{ iif(lm.length() >= 19, lm.substring(0, 10) + ' ' + lm.substring(11, 8) + iif(lm.length() > 19, ' UTC' + iif(lm.substring(19) = 'Z', '', lm.substring(19)), ''), lm) }}</span>{% endif %}
</div>
{% endif %}
</div>

{% if requester.exists() or owner.exists() %}
<div style="background:#ffffff;border-radius:18px;padding:32px;margin-bottom:32px;box-shadow:0 8px 28px rgba(0,0,0,0.08),0 2px 10px rgba(0,0,0,0.06);">
<div style="font-size:24px;font-weight:600;color:#007aff;margin:0 0 24px 0;padding-bottom:12px;border-bottom:1px solid #e5e5ea;display:flex;justify-content:space-between;align-items:center;">Parties Involved</div>
{% if requester.exists() %}
